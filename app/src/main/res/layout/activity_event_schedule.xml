<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_marginTop="25dp"
    android:background="#F7F3FB"
    tools:context=".EventScheduleActivity">

    <TextView
        android:id="@+id/txtbackschedule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="15dp"
        android:text="Back"
        android:textColor="#6D3BA5"
        android:textSize="16sp"
        android:textStyle="bold">
    </TextView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:text="Event Schedule"
        android:textColor="#6D3BA5"
        android:textSize="24sp"
        android:textStyle="bold">
    </TextView>

    <TextView
        android:id="@+id/txteventschedulename"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="8dp"
        android:text="Event Name"
        android:textColor="#444444"
        android:textSize="16sp">
    </TextView>

    <TextView
        android:id="@+id/txtscheduleeventdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="5dp"
        android:text="Event Date"
        android:textColor="#777777"
        android:textSize="14sp">
    </TextView>

    <TextView
        android:id="@+id/txtnoschedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="25dp"
        android:text="No schedule available for this event."
        android:textColor="#777777"
        android:textSize="15sp"
        android:visibility="gone">
    </TextView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerviewschedule"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="10dp"
        android:paddingBottom="15dp">
    </androidx.recyclerview.widget.RecyclerView>

</LinearLayout>