<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#F7F3FB"
    android:scrollbars="none"
    tools:context=".EventDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtbackevent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textSize="16sp"
            android:textColor="#6D3BA5"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">
        </TextView>

        <ImageView
            android:id="@+id/imgeventdetail"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:src="@drawable/grand_festival"
            android:background="@drawable/forgot_dialog_bg">
        </ImageView>

        <TextView
            android:id="@+id/txteventtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grand Festival Celebration"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#6D3BA5"
            android:layout_marginTop="20dp">
        </TextView>

        <TextView
            android:id="@+id/txteventcategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/selected_category"
            android:padding="10dp"
            android:text="Celebration"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="14sp">
        </TextView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/forgot_dialog_bg"
            android:padding="20dp"
            android:elevation="3dp"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📅  Date"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#292333">
            </TextView>

            <TextView
                android:id="@+id/txteventdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Event date will appear here"
                android:textSize="14sp"
                android:textColor="#51465F"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp">
            </TextView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🕒  Time"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#292333">
            </TextView>

            <TextView
                android:id="@+id/txteventtime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Event time will appear here"
                android:textSize="14sp"
                android:textColor="#51465F"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp">
            </TextView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍  Location"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#292333">
            </TextView>

            <TextView
                android:id="@+id/txteventlocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Event venue will appear here"
                android:textSize="14sp"
                android:textColor="#51465F"
                android:layout_marginTop="6dp">
            </TextView>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About this Event"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#292333"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp">
        </TextView>

        <TextView
            android:id="@+id/txteventdescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Discover the details of this amazing event and enjoy an unforgettable experience with friends and family."
            android:textSize="15sp"
            android:textColor="#51465F"
            android:lineSpacingExtra="5dp">
        </TextView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnregisterevent"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Register for Event"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/custom_button"
            android:backgroundTint="@null"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp">
        </androidx.appcompat.widget.AppCompatButton>

    </LinearLayout>

</ScrollView>
