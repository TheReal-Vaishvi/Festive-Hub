<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtVolunteername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volunteer Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#292333" />

        <TextView
            android:id="@+id/txtVolunteeremail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textSize="14sp"
            android:textColor="#625D6B"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/txtVolunteermobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mobile"
            android:textSize="14sp"
            android:textColor="#625D6B"
            android:layout_marginTop="5dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnViewvolunteer"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="View Details"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:background="@drawable/custom_button"
            android:backgroundTint="@null"
            android:layout_gravity="end"
            android:layout_marginTop="10dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEditvolunteer"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Edit Details"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:background="@drawable/custom_button"
            android:backgroundTint="@null"
            android:layout_gravity="end"
            android:layout_marginTop="6dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDeletevolunteer"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Delete Volunteer"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:background="@drawable/custom_button"
            android:backgroundTint="#D32F2F"
            android:layout_gravity="end"
            android:layout_marginTop="6dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
