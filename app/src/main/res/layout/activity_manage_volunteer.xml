<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F7F3FB"
    android:layout_marginTop="15dp"
    tools:context=".ManageVolunteerActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Volunteers"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="16dp">
    </TextView>

    <EditText
        android:id="@+id/edtSearchvolunteer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search by name or email"
        android:textStyle="bold"
        android:padding="12dp"
        android:singleLine="true"
        android:inputType="text"
        android:background="@drawable/custom_edittext"
        android:elevation="2dp">
    </EditText>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAddvolunteer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Volunteer"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:background="@drawable/custom_button"
        android:backgroundTint="@null"
        android:layout_marginTop="12dp"
        android:elevation="5dp"
        android:layout_marginBottom="12dp">
    </androidx.appcompat.widget.AppCompatButton>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVolunteers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="10dp">
    </androidx.recyclerview.widget.RecyclerView>

</LinearLayout>
