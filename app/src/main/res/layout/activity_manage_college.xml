<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F3FB"
    android:padding="20dp"
    android:layout_marginTop="10dp"
    tools:context=".ManageCollegeActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Colleges"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#292333"
        android:layout_marginBottom="18dp">
    </TextView>

    <EditText
        android:id="@+id/edtSearchclg"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Search by college name or city"
        android:inputType="text"
        android:padding="14dp"
        android:textSize="14sp"
        android:textColor="#292333"
        android:textColorHint="#9990A3"
        android:background="@drawable/custom_edittext"
        android:layout_marginBottom="16dp">
    </EditText>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAddclg"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Add College"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/custom_button"
        android:backgroundTint="@null"
        android:layout_marginBottom="18dp">
    </androidx.appcompat.widget.AppCompatButton>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvColleges"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="10dp"
        tools:listitem="@layout/item_college">
    </androidx.recyclerview.widget.RecyclerView>

</LinearLayout>

