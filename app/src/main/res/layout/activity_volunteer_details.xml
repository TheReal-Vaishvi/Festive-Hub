<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#F7F3FB"
    android:fillViewport="true"
    android:layout_marginTop="15dp"
    tools:context=".VolunteerDetailsActivity">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="10dp"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volunteer Details"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="24dp">
    </TextView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Name"
        android:textStyle="bold"
        android:textColor="#292333">
    </TextView>

    <TextView
        android:id="@+id/txtDetailVolunteerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Name"
        android:textSize="17sp"
        android:textColor="#292333"
        android:layout_marginBottom="18dp">
    </TextView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Email"
        android:textStyle="bold"
        android:textColor="#292333">
    </TextView>

    <TextView
        android:id="@+id/txtDetailVolunteerEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Email"
        android:textSize="17sp"
        android:textColor="#292333"
        android:layout_marginBottom="18dp">
    </TextView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mobile"
        android:textStyle="bold"
        android:textColor="#292333">
    </TextView>

    <TextView
        android:id="@+id/txtDetailVolunteerMobile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mobile"
        android:textSize="17sp"
        android:textColor="#292333"
        android:layout_marginBottom="18dp">
    </TextView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="College"
        android:textStyle="bold"
        android:textColor="#292333">
    </TextView>

    <TextView
        android:id="@+id/txtDetailVolunteerCollege"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="College"
        android:textSize="17sp"
        android:textColor="#292333"
        android:layout_marginBottom="18dp">
    </TextView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Created At"
        android:textStyle="bold"
        android:textColor="#292333">
    </TextView>

    <TextView
        android:id="@+id/txtDetailVolunteerCreatedAt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Created At"
        android:textSize="17sp"
        android:textColor="#292333"
        android:layout_marginBottom="18dp">
    </TextView>

</LinearLayout>

</ScrollView>
