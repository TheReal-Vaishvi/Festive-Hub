<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:fillViewport="true"
    android:background="#F7F3FB"
    android:scrollbars="none"
    tools:context=".AdminLoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Festive Hub"
            android:textStyle="bold"
            android:textSize="30dp"
            android:textColor="#6D3BA5"
            android:layout_marginBottom="8dp">
        </TextView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Login"
            android:textSize="25dp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="25dp">
        </TextView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/login_card"
            android:elevation="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin Email"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#292333">
            </TextView>

            <EditText
                android:id="@+id/edtadminemail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Enter Admin Email"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:padding="14dp"
                android:background="@drawable/custom_edittext"
                android:textSize="14dp"
                android:textColor="#292333"
                android:textColorHint="#9990A3"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp">
            </EditText>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#292333">
            </TextView>

            <EditText
                android:id="@+id/edtadminpw"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Enter Admin password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:padding="14dp"
                android:background="@drawable/custom_edittext"
                android:textSize="14sp"
                android:textColor="#292333"
                android:textColorHint="#9990A3"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp">
            </EditText>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnadminlogin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Admin Login"
                android:textStyle="bold"
                android:textSize="15dp"
                android:textColor="@color/white"
                android:background="@drawable/custom_button"
                android:backgroundTint="@null"
                android:layout_marginTop="25dp">
            </androidx.appcompat.widget.AppCompatButton>

            <TextView
                android:id="@+id/txtbacktologin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back to Student Login?"
                android:layout_gravity="center"
                android:textSize="14dp"
                android:layout_marginTop="20dp"
                android:textColor="#6D3BA5">
            </TextView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>